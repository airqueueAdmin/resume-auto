SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
APP_VERSION=dev
DB_URL=jdbc:postgresql://localhost:5432/ai_career
DB_USERNAME=ai_career
DB_PASSWORD=local_password
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=3000
POSTGRES_DB=ai_career
POSTGRES_USER=ai_career
POSTGRES_PASSWORD=local_password
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
EXTENSION_ALLOWED_ORIGIN_PATTERNS=chrome-extension://*,http://localhost:5173,http://127.0.0.1:5173
JWT_ISSUER=ai-career-platform
JWT_SECRET_BASE64=replace-with-a-random-base64-secret
DATA_ENCRYPTION_KEY_BASE64=replace-with-a-random-32-byte-base64-key
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_HMAC_SECRET_BASE64=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Career Note
JWT_ACCESS_TOKEN_TTL=PT15M
JWT_REFRESH_TOKEN_TTL=P14D
AI_PROVIDER=gemini
AI_PROMPT_VERSION=job-analysis-v1
AI_TIMEOUT=PT120S
AI_MAX_ATTEMPTS=2
AI_RETRY_DELAY=PT0.1S
AI_MAX_OUTPUT_TOKENS=1200
AI_TEMPERATURE=0.1
AI_MATCH_PROMPT_VERSION=job-match-v1
AI_MATCH_TOP_K=8
AI_MATCH_MAX_CONTEXT_CHARACTERS=12000
AI_RESUME_DRAFT_PROMPT_VERSION=resume-draft-v7
AI_RESUME_DRAFT_TOP_K=8
AI_RESUME_DRAFT_MAX_CONTEXT_CHARACTERS=30000
AI_RESUME_DRAFT_MAX_OUTPUT_TOKENS=4096
AI_RESUME_DRAFT_GEMINI_THINKING_BUDGET=512
AI_RESUME_DRAFT_MAX_ATTEMPTS=2
AI_RESUME_DRAFT_OLLAMA_FALLBACK_ENABLED=true
AI_RESUME_DRAFT_OLLAMA_TIMEOUT=PT300S
AI_SELF_INTRODUCTION_PROMPT_VERSION=self-introduction-v5
AI_SELF_INTRODUCTION_TOP_K=8
AI_SELF_INTRODUCTION_MIN_SIMILARITY=0.45
AI_SELF_INTRODUCTION_MAX_CONTEXT_CHARACTERS=24000
AI_SELF_INTRODUCTION_MAX_OUTPUT_TOKENS=1800
AI_SELF_INTRODUCTION_GEMINI_THINKING_BUDGET=0
