AI_SELF_INTRODUCTION_MAX_ATTEMPTS=2
AI_SELF_INTRODUCTION_OLLAMA_TIMEOUT=PT300S
AI_SELF_INTRODUCTION_OLLAMA_MAX_OUTPUT_TOKENS=900
OLLAMA_CHAT_URL=http://localhost:11434/api/chat
COMPOSE_OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
