GEMINI_TIMEOUT=PT90S
GEMINI_MAX_ATTEMPTS=1
GEMINI_RETRY_DELAY=PT0.1S
GEMINI_MAX_OUTPUT_TOKENS=4096
OLLAMA_EMBEDDING_URL=http://localhost:11434/api/embed
