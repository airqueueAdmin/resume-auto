# Copy this file to .env.oracle on the Oracle VM. Replace every placeholder
# before starting the Compose stack. Never commit the copied file.

POSTGRES_DB=ai_career
POSTGRES_USER=ai_career
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=5173

JWT_ISSUER=ai-career-platform
JWT_SECRET_BASE64=replace-with-at-least-32-random-decoded-bytes-in-base64

# Gmail SMTP. Use a dedicated Gmail account, enable two-step verification, and
# generate an app password. Remove spaces from the displayed 16-character password.
EMAIL_VERIFICATION_ENABLED=true
EMAIL_VERIFICATION_HMAC_SECRET_BASE64=replace-with-at-least-32-random-decoded-bytes-in-base64
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=replace-with-dedicated-account@example.com
SMTP_PASSWORD=replace-with-16-character-google-app-password
SMTP_STARTTLS_ENABLED=true
SMTP_SSL_ENABLED=false
EMAIL_FROM_ADDRESS=replace-with-dedicated-account@example.com
EMAIL_FROM_NAME=Career Note

# Protect the free Gmail quota. These in-memory counters reset when the backend restarts.
EMAIL_VERIFICATION_RATE_LIMIT_ENABLED=true
EMAIL_VERIFICATION_CLIENT_RATE_LIMIT_WINDOW=PT1H
EMAIL_VERIFICATION_MAX_CLIENT_REQUESTS=20
EMAIL_VERIFICATION_DELIVERY_RATE_LIMIT_WINDOW=P1D
EMAIL_VERIFICATION_MAX_DELIVERIES=400

GEMINI_API_KEY=replace-with-a-server-side-gemini-key
COMPOSE_OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
COMPOSE_OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434/api/embed

# Keep the connection pool small for the Always Free VM and three-user scope.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=5000
