# Copy this file to .env.oracle on the Oracle VM. Replace every placeholder
# before starting the Compose stack. Never commit the copied file.

POSTGRES_DB=ai_career
POSTGRES_USER=ai_career
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=5432
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=8080
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_HOST_PORT=5173

JWT_ISSUER=ai-career-platform
JWT_SECRET_BASE64=replace-with-at-least-32-random-decoded-bytes-in-base64

GEMINI_API_KEY=replace-with-a-server-side-gemini-key
COMPOSE_OLLAMA_CHAT_URL=http://host.docker.internal:11434/api/chat
COMPOSE_OLLAMA_EMBEDDING_URL=http://host.docker.internal:11434/api/embed

# Keep the connection pool small for the Always Free VM and three-user scope.
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=1
DB_CONNECTION_TIMEOUT_MS=5000
