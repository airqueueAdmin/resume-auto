# Render injects these values into the career-note-api service.
# Copy the connection details from Supabase Dashboard > Connect > Session pooler.
# Do not commit real values or use the transaction pooler for Spring Boot/Flyway.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://<supabase-session-pooler-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres.<supabase-project-ref>
DB_PASSWORD=replace-with-the-supabase-database-password
JWT_ISSUER=career-note
JWT_SECRET_BASE64=replace-with-a-random-base64-secret
GEMINI_API_KEY=replace-with-a-server-side-gemini-key

# Keep these disabled unless a separately hosted Ollama embedding endpoint is configured.
AI_PROVIDER=gemini
AI_RESUME_DRAFT_PROVIDER=gemini
AI_RESUME_DRAFT_OLLAMA_FALLBACK_ENABLED=false
AI_SELF_INTRODUCTION_OLLAMA_FALLBACK_ENABLED=false
